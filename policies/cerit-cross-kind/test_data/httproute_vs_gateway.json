{
  "uid": "test-httproute-vs-gateway",
  "kind": {
    "group": "gateway.networking.k8s.io",
    "kind": "HTTPRoute",
    "version": "v1"
  },
  "resource": {
    "group": "gateway.networking.k8s.io",
    "version": "v1",
    "resource": "httproutes"
  },
  "name": "hr-vs-gw",
  "operation": "CREATE",
  "userInfo": {
    "username": "test-user",
    "groups": ["system:masters", "system:authenticated"]
  },
  "object": {
    "apiVersion": "gateway.networking.k8s.io/v1",
    "kind": "HTTPRoute",
    "metadata": {
      "name": "hr-vs-gw",
      "namespace": "default"
    },
    "spec": {
      "hostnames": ["gw-host.example.com"],
      "rules": [
        {
          "matches": [
            {
              "path": {
                "type": "PathPrefix",
                "value": "/"
              }
            }
          ],
          "backendRefs": [
            {
              "name": "service1",
              "port": 80
            }
          ]
        }
      ]
    }
  }
}
